DB_NAME=radar_class
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
GEMINI_API_KEY=pega-tu-api-key-de-gemini
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGIN=http://localhost:5173
